.DS_Store

# Firebase iOS — never commit (GitHub secret scanning; keys belong per-app from Console)
clients/ios/GoogleService-Info.plist

# Xcode (user-specific)
**/xcuserdata/
**/*.xcuserstate
*.xcscmblueprint

# SwiftPM / Xcode (optional local resolution; commit Package.resolved when present for reproducible builds)
.swiftpm/configuration/

# Android (JewelHeart Admin) — Firebase; build outputs
clients/android/jewelheart-admin/google-services.json
clients/android/**/build/
clients/android/.gradle/
clients/android/local.properties
