# Copy to keystore.properties (same directory as this file) and fill in.
# Paths are relative to clients/android/ (Gradle root for the app module).
#
# Verify SHA1 before uploading to Play Console:
#   keytool -list -v -keystore <storeFile> -alias <keyAlias>
# Play expects your *upload certificate* fingerprint to match what the console shows.

storeFile=
storePassword=
keyAlias=
keyPassword=
