              "textAlign": "center",
              "color": "#FFFFFF"
            },
            "style": {
              "backgroundColor": "#7A95CA",
              "padding": { "top": 10, "bottom": 10, "left": 8, "right": 8 }
            }
          },
          {
            "type": "text",
            "content": "Volunteer Home - Day 2, Tue July 21",
