              "fontSize": 17,
              "fontWeight": "bold",
              "textAlign": "center",
              "color": "#FFFFFF"
            },
            "style": {
              "backgroundColor": "#7A95CA",
              "padding": { "top": 10, "bottom": 10, "left": 8, "right": 8 }
